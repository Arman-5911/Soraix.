# Set the public deployment URL when generating the sitemap.
SITE_URL=https://your-soraix-domain.example
# Direct provider is enabled by default. Set to none to use only your private library.
STREAMING_PROVIDER=animeparadise
# Optional: private per-episode sources take priority over the direct provider.
# This file must be outside public/ and must contain only video URLs you can distribute.
# VIDEO_LIBRARY_PATH=D:/anime/private/video-library.json
PORT=5173
# Optional external English subtitle lookup (server-only key from jimaku.cc).
# JIMAKU_API_KEY=
